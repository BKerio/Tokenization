# Leave empty: the client calls /api on its own origin.
#  - Production (Vercel): vercel.json rewrites /api/* to the FastAPI server.
#  - Development: the Vite dev server proxies /api to API_PROXY_TARGET.
# Only set this to call a backend directly, e.g. VITE_API_URL="http://127.0.0.1:8000".
VITE_API_URL=""

# Dev only: where the Vite dev server proxies /api requests.
API_PROXY_TARGET="http://75.119.136.33:8000"
